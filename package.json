{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.local.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "wrangler types && tsc --noEmit",
    "test": "tsx --test src/utils/admin.test.ts src/utils/audioFallback.test.ts src/utils/campaign.test.ts src/utils/persona.test.ts src/utils/scraper.test.ts src/utils/security.test.ts src/utils/authApi.integration.test.ts src/utils/speechSynthesisService.test.ts src/utils/healthRuntime.test.ts",
    "dev:worker": "wrangler dev",
    "build:worker": "wrangler deploy --dry-run",
    "build:worker:preview": "wrangler deploy --config wrangler.preview.jsonc --dry-run",
    "deploy:worker": "wrangler deploy",
    "postinstall": "node scripts/patch-express-worker.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.16.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "wrangler": "^4.44.0"
  }
}
