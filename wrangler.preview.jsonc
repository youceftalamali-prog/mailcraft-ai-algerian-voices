{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mailcraft-ai-preview",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "vars": {
    "GOOGLE_CLIENT_ID": "144615124580-lv0vnbh21na92ooh261sgloj6dsdlvo8.apps.googleusercontent.com"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "4d3acf497c5b45f99f1a4bf914818845"
    }
  ]
}
