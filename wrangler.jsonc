{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mailcraft-ai",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "f7820c37ac9e42b2b92cd9793b7f1aa1"
    }
  ]
}
